# Copy to .env (never commit .env). Platform settings use the WORKFORCE_ prefix.
POSTGRES_PASSWORD=change-me
WORKFORCE_ENVIRONMENT=production
WORKFORCE_TENANTS=homemonde
WORKFORCE_ALLOWED_HOSTS=workforce.example.com
WORKFORCE_SECURE_COOKIES=true
WORKFORCE_WORKER_CONCURRENCY=2

# Encrypts AI keys that owners paste into the panel (Operations › AI models & keys). Generate once with
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# and keep it safe: if it changes, keys saved in the panel must be entered again.
WORKFORCE_SECRET_KEY=

# Model provider keys. Optional when owners add keys in the panel; only the providers in use are needed.
# Without any key the workforce still runs and reports verified facts.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
HF_TOKEN=

# Optional per-deployment model choice for HomeMonde (provider:model[:effort]); defaults are in its tenant pack.
# HOMEMONDE_STRONG_MODEL=anthropic:claude-sonnet-5-5:medium
# HOMEMONDE_PREMIUM_MODEL=anthropic:claude-opus-5-5:medium
# HOMEMONDE_CHEAP_MODEL=anthropic:claude-haiku-5-5:low

# Tenant pack secrets and paths referenced as ${...} in tenants/<id>/tenant.yaml
HOMEMONDE_EXPORTS_DIR=/data/exports
# Mail server for actions with handler: email (smtp://user:password@host:587 or smtps://...:465)
# HOMEMONDE_SMTP_URL=
EXPORTS_DIR=./exports
