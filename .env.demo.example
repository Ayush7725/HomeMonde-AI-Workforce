# Copy to .env.demo (never commit it) to let the demo's AI employees use a model. All optional:
# with no key the demo still runs and every employee reports verified facts only.

# Free option: a Google AI Studio key (https://aistudio.google.com/apikey). The free tier has low daily
# limits and Google may use free-tier prompts to improve its products, so use it with demo data only.
# GEMINI_API_KEY=
# Free-tier quotas are per model, so the tiers use different models. Model names change often: list the
# ones your key can use at https://aistudio.google.com (checked 22 Oct 2026; gemini-2.5-* no longer accept new keys).
# The full Flash model allows only ~20 requests a day on the free tier, so it is kept for urgent alerts.
# HOMEMONDE_STRONG_MODEL=gemini:gemini-3.5-flash-lite
# HOMEMONDE_PREMIUM_MODEL=gemini:gemini-3.8-flash
# HOMEMONDE_CHEAP_MODEL=gemini:gemini-3.1-flash-lite
# the three other demo companies:
# DEMO_STRONG_MODEL=gemini:gemini-3.5-flash-lite
# DEMO_CHEAP_MODEL=gemini:gemini-3.1-flash-lite

# Any other provider works the same way (set its key and point the models at it), e.g.
# ANTHROPIC_API_KEY=          HOMEMONDE_STRONG_MODEL=anthropic:claude-sonnet-5-5:medium
# OPENAI_API_KEY=             HOMEMONDE_STRONG_MODEL=openai:<model>
# DEEPSEEK_API_KEY=           HOMEMONDE_STRONG_MODEL=deepseek:deepseek-chat
# With no model variables set, the packs' own defaults (Claude) are used.

# Free tiers allow only a few requests a minute: investigate one task at a time.
# WORKFORCE_WORKER_CONCURRENCY=1
